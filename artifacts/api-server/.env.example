# ---------------------------------------------------------------------------
# API Server — environment variable reference (tuning knobs)
# ---------------------------------------------------------------------------
# For local dev the canonical, complete env file is the repo-root .env (see
# ../../.env.example) — the server loads it automatically. This file documents
# api-server-specific tuning vars; values placed in a local artifacts/api-server/.env
# override the root .env. Variables marked "required" must be set somewhere.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# TCP port the API server listens on (required).
PORT=3001

# ---------------------------------------------------------------------------
# AI Scanning — rasterization quality
# ---------------------------------------------------------------------------

# Resolution (dots per inch) used when converting PDF floor-plan sheets to
# images before sending them to the AI vision model.
#
# Higher values improve accuracy on fine details (small room labels, thin
# walls) at the cost of larger images, longer upload times, and higher
# AI-vision token usage.
#
# Recommended range: 100–300
#   100  — fast/cheap; may miss small text on dense plans
#   150  — default; good balance for standard 24"×36" sheets
#   200  — higher fidelity; ~78% larger images than 150 DPI
#   300  — maximum recommended; ~4× larger images than 150 DPI
#
# Changing this value invalidates the Step 3 rasterization cache, so the
# next job run for each sheet will re-rasterize and re-upload the image.
#
# Default: 150
RASTERIZE_DPI=150

# ---------------------------------------------------------------------------
# AI Scanning — vision call cap
# ---------------------------------------------------------------------------

# Maximum number of Claude AI vision calls allowed in a single pipeline run
# (Step 6b – room verification). Sheets beyond this limit are skipped with a
# warning so operators know the cap was reached.
#
# Default: 10
AI_VISION_CALLS_PER_RUN=10

# ---------------------------------------------------------------------------
# Concurrency / throughput (Phase 1 speed knobs)
# ---------------------------------------------------------------------------
# These trade wall-clock latency against load on the PDF sidecar and Gemini
# rate limits. Defaults are conservative; raise them once the sidecar is running
# concurrently (see SIDECAR_MAX_CONCURRENCY in the root .env.example).

# Max pipeline runs allowed to execute at the same time. A new upload beyond
# this is rejected with a "pipeline busy" error. Default: 4
MAX_CONCURRENT_PIPELINES=4

# Floor-plan sheets rasterized + vision-scanned in parallel per batch
# (Step 3 / room extraction). Higher = faster but more concurrent Gemini calls.
# Default: 4
SHEET_BATCH_SIZE=4

# Uploaded PDFs whose drawing index is parsed in parallel in Step 2. Each is an
# independent sidecar call. Default: 3
STEP2_FILE_CONCURRENCY=3

# ---------------------------------------------------------------------------
# AI Scanning — model selection
# ---------------------------------------------------------------------------

# Gemini API key for vision scanning (optional).
# When set, Gemini 1.5 Flash is used as the primary vision model for all
# pipeline scan steps (room extraction, plaque schedule, occupant loads,
# estimator dict, estimator assign). Claude Sonnet is used as the fallback
# when this key is absent.
#
# Get your key at: https://aistudio.google.com/app/apikey
#
# Default: (unset — uses Claude Sonnet)
GEMINI_API_KEY=
