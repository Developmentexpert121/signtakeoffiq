# ---------------------------------------------------------------------------
# Web (Vite) environment — copy to artifacts/web/.env.local
# ---------------------------------------------------------------------------
# Only VITE_-prefixed vars reach the browser. Backend secrets live in the
# repo-root .env (see ../../.env.example).

# Skip auth in local dev (mirrors DEV_BYPASS_AUTH on the server).
VITE_DEV_BYPASS_AUTH=true

# Clerk publishable key. App.tsx requires this even with dev bypass on (the
# ClerkProvider still mounts). Publishable keys are safe to expose in the
# client. Create a free dev instance at https://dashboard.clerk.com.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where the Vite dev server proxies /api, /healthz and /storage. Defaults to
# the api-server's local PORT; only change if the API runs elsewhere.
VITE_API_PROXY_TARGET=http://localhost:3001
