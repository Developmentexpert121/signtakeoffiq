{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env ./src/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "eslint": "^10.2.0",
    "tsx": "catalog:",
    "typescript-eslint": "^8.58.2"
  }
}
