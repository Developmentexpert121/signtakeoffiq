# ---------------------------------------------------------------------------
# Sign Takeoff IQ — repo-root environment (backend: api-server + db tooling)
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. This file is the single source for backend secrets
# in local dev:
#   - api-server loads it on `pnpm dev` / `pnpm start` (via --env-file-if-exists)
#   - db tooling loads it on `pnpm db:push` / `pnpm db:seed`
#   - docker compose reads it for POSTGRES_* substitution
# Web (Vite) vars live in artifacts/web/.env.local — see artifacts/web/.env.example.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Local dev convenience: enables dev features and skips real auth (see below).
NODE_ENV=development

# ── Database (matches docker-compose.yml defaults) ──────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/signtakeoff
# Used only by docker compose for the postgres container:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=signtakeoff

# ── AI (vision pipeline) ────────────────────────────────────────────────────
# Anthropic is required for the server to boot (Claude is the vision fallback).
ANTHROPIC_API_KEY=sk-ant-...
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional: when set, Gemini is the primary vision model.
GEMINI_API_KEY=
# Keep modest while testing — caps new vision calls per pipeline run.
AI_VISION_CALLS_PER_RUN=10

# ── AI model selection (per-step, overridable) ──────────────────────────────
# Defaults preserve the proven gemini-2.5 behaviour. Room extraction (the tile
# scans) is the single largest time bucket — pointing it at a faster Gemini 3
# model is the biggest available speed lever. Verify the exact model id against
# the live Gemini API, then validate any swap with scripts/takeoff-eval
# (precision/recall must hold) BEFORE rolling out.
#   ROOM_EXTRACTION_MODEL — Step 3 floor-plan room/tile scans (biggest cost)
#   VISION_MODEL          — general vision (occupant loads, code/egress sheets)
#   SCHEDULE_MODEL        — dense schedule/plaque/specialty table extraction
ROOM_EXTRACTION_MODEL=gemini-2.5-pro
VISION_MODEL=gemini-2.5-pro
SCHEDULE_MODEL=gemini-2.5-flash
# Example Gemini 3 upgrade (uncomment + verify ids, then run the eval harness):
# ROOM_EXTRACTION_MODEL=gemini-3-flash
# VISION_MODEL=gemini-3-pro
# SCHEDULE_MODEL=gemini-3-flash

# ── Concurrency / throughput (Phase 1 speed knobs) ──────────────────────────
# Trade latency against sidecar load + Gemini rate limits. Defaults shown.
MAX_CONCURRENT_PIPELINES=4   # simultaneous pipeline runs (a 5th upload is rejected)
SHEET_BATCH_SIZE=4           # floor-plan sheets vision-scanned in parallel per batch
STEP2_FILE_CONCURRENCY=3     # PDFs whose drawing index is parsed in parallel (Step 2)
STEP4B_EXT_CONCURRENCY=4     # floor-plan sheets whose embedded schedule tables are extracted in parallel
SCHEDULE_RETRY_DPI=300       # DPI of the Step 3a high-DPI schedule re-render fallback (lower = faster, e.g. 220)
# Reuse cached AI scans across re-runs of the same job (off in dev = always fresh).
# Enable in production so re-runs skip already-completed vision scans.
# PIPELINE_CACHE_ENABLED=true

# ── Object storage: DigitalOcean Spaces (S3-compatible) ─────────────────────
# STORAGE_DRIVER=s3 uses the endpoint below; =gcs uses Replit object storage.
# If omitted, the driver is inferred as s3 when S3_* / DO_SPACES_* are present.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set true only for non-virtual-hosted S3 endpoints (e.g. MinIO).
S3_FORCE_PATH_STYLE=false
# Bucket + optional prefix for private/public objects. Format: /<bucket>[/<prefix>]
PRIVATE_OBJECT_DIR=/your-space-name/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-space-name/public

# ── PDF sidecar ─────────────────────────────────────────────────────────────
# Runs in Docker (see docker-compose.yml). The API talks to it here.
PDF_SIDECAR_URL=http://localhost:8008
# Sidecar-side knobs (consumed by the Python service, passed through by docker
# compose). SIDECAR_MAX_CONCURRENCY caps simultaneous heavy render/parse work so
# a burst of large sheets can't exhaust memory; SIDECAR_CACHE_MAX_BYTES bounds
# the in-memory render/parse cache. Defaults: 4 and 536870912 (512 MB).
SIDECAR_MAX_CONCURRENCY=4
SIDECAR_CACHE_MAX_BYTES=536870912

# ── Logging ─────────────────────────────────────────────────────────────────
# When set, the pipeline narrative (the [Step …]/[pipeline]/[timing] console
# lines) is tee'd to this file alongside terminal output. HTTP request logs stay
# terminal-only and are not written to the file.
# Path is relative to the api-server process cwd (artifacts/api-server/).
# ../../pipeline-logs.txt lands at the repo root. Unset to disable file logging.
LOG_FILE=../../pipeline-logs.txt

# ── Auth (local dev) ────────────────────────────────────────────────────────
# Skips Clerk/JWT and injects a fixed admin on the "default" tenant.
DEV_BYPASS_AUTH=true
# Required for guest-session JWTs (any random string locally).
GUEST_JWT_SECRET=dev-secret
